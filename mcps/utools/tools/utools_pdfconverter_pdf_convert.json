{
  "name": "utools_pdfconverter_pdf_convert",
  "description": "将 PDF 文件转换为 Word、PPT、Excel 格式 [utools:utools.pdfconverter.pdf_convert]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "description": "PDF 文件路径"
      },
      "format": {
        "type": "string",
        "enum": [
          "word",
          "ppt",
          "excel"
        ],
        "description": "目标格式，支持 word、ppt、excel"
      }
    },
    "required": [
      "inputPath",
      "format"
    ],
    "additionalProperties": false
  }
}