{
  "name": "utools_pdfconverter_pdf_split",
  "description": "将 PDF 文件按指定页码拆分为多个文件 [utools:utools.pdfconverter.pdf_split]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "description": "PDF 文件路径"
      },
      "splitIndexs": {
        "type": "array",
        "items": {
          "type": "number",
          "description": "拆分点页码（从1开始）"
        },
        "description": "拆分页码数组，例如 [2, 5] 表示在第2页和第5页后拆分"
      }
    },
    "required": [
      "inputPath",
      "splitIndexs"
    ],
    "additionalProperties": false
  }
}