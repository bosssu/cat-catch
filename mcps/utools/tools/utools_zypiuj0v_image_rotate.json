{
  "name": "utools_zypiuj0v_image_rotate",
  "description": "旋转图片指定的角度，支持 -360 到 360 度之间的旋转。 [utools:utools.zypiuj0v.image_rotate]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "format": "uri",
        "description": "图片文件路径"
      },
      "angle": {
        "type": "integer",
        "minimum": -360,
        "maximum": 360,
        "description": "旋转角度，-360 到 360 度之间的整数"
      }
    },
    "required": [
      "inputPath",
      "angle"
    ],
    "additionalProperties": false
  }
}