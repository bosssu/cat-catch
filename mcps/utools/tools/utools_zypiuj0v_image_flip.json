{
  "name": "utools_zypiuj0v_image_flip",
  "description": "翻转图片，支持左右翻转（水平翻转）和上下翻转（垂直翻转）。 [utools:utools.zypiuj0v.image_flip]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "format": "uri",
        "description": "图片文件路径"
      },
      "way": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "description": "翻转方向"
      }
    },
    "required": [
      "inputPath",
      "way"
    ],
    "additionalProperties": false
  }
}