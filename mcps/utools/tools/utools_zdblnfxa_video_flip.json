{
  "name": "utools_zdblnfxa_video_flip",
  "description": "对视频进行翻转操作，支持水平、垂直或同时翻转。 [utools:utools.zdblnfxa.video_flip]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "description": "输入视频文件的绝对路径"
      },
      "flipMode": {
        "default": "horizontal",
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "description": "翻转模式：horizontal=水平，vertical=垂直"
      }
    },
    "required": [
      "inputPath"
    ],
    "additionalProperties": false
  }
}