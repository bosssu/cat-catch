{
  "name": "utools_pdfconverter_pdf_compress",
  "description": "压缩 PDF 文件，减小文件大小 [utools:utools.pdfconverter.pdf_compress]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "description": "PDF 文件路径"
      },
      "compressionLevel": {
        "default": "basic",
        "type": "string",
        "enum": [
          "strong",
          "basic"
        ],
        "description": "压缩等级，默认 basic"
      }
    },
    "required": [
      "inputPath"
    ],
    "additionalProperties": false
  }
}