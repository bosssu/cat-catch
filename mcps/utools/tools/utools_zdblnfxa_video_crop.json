{
  "name": "utools_zdblnfxa_video_crop",
  "description": "按指定宽高比裁剪视频画面 [utools:utools.zdblnfxa.video_crop]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "inputPath": {
        "type": "string",
        "description": "输入视频文件绝对路径"
      },
      "ratio": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?$",
        "description": "目标宽高比，例如 16:9、4:3、2:3、1:1，也支持小数比例如 1.85:1"
      }
    },
    "required": [
      "inputPath",
      "ratio"
    ],
    "additionalProperties": false
  }
}