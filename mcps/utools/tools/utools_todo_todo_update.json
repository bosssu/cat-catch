{
  "name": "utools_todo_todo_update",
  "description": "根据 patch 字段更新待办事项 [utools:utools.todo.todo_update]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "待办事项的ID（必填）"
      },
      "patch": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "更新待办内容"
          },
          "status": {
            "type": "string",
            "description": "更新状态：done=已完成，pending=未完成"
          },
          "dueAt": {
            "type": "string",
            "description": "更新结束日期，格式：2024-12-31"
          },
          "group": {
            "type": "string",
            "description": "更新分组名称，不存在则自动创建"
          }
        },
        "description": "要更新的字段"
      }
    },
    "required": [
      "id",
      "patch"
    ],
    "additionalProperties": false
  }
}