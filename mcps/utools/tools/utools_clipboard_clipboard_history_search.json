{
  "name": "utools_clipboard_clipboard_history_search",
  "description": "搜索剪贴板历史记录，可返回文本、图片或文件。 [utools:utools.clipboard.clipboard_history_search]",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "搜索关键词，可匹配文本内容或文件名；不提供或为空时返回最近的历史记录"
      },
      "type": {
        "default": "all",
        "type": "string",
        "enum": [
          "text",
          "image",
          "files",
          "all"
        ],
        "description": "返回的内容类型"
      },
      "limit": {
        "default": 10,
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "返回最大数量"
      }
    },
    "additionalProperties": false
  }
}